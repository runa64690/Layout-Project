{
  "openapi": "3.1.0",
  "info": {
    "title": "Furniture Layout API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/catalog": {
      "get": {
        "summary": "Catalog",
        "operationId": "catalog_api_v1_catalog_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/evaluate": {
      "post": {
        "summary": "Evaluate",
        "operationId": "evaluate_api_v1_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LayoutDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/optimization-jobs": {
      "post": {
        "summary": "Optimize",
        "operationId": "optimize_api_v1_optimization_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizationDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/optimization-jobs/{job_id}": {
      "get": {
        "summary": "Job",
        "operationId": "job_api_v1_optimization_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CandidateDTO": {
        "properties": {
          "evaluation_version": {
            "type": "integer",
            "title": "Evaluation Version",
            "default": 2
          },
          "placements": {
            "items": {
              "$ref": "#/components/schemas/PlacementDTO"
            },
            "type": "array",
            "title": "Placements"
          },
          "cost": {
            "type": "number",
            "title": "Cost"
          },
          "score_breakdown": {
            "items": {
              "$ref": "#/components/schemas/ScoreTerm"
            },
            "type": "array",
            "title": "Score Breakdown"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Violations"
          },
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "accepted_steps": {
            "type": "integer",
            "title": "Accepted Steps"
          },
          "source_sample_index": {
            "type": "integer",
            "title": "Source Sample Index"
          },
          "safety": {
            "$ref": "#/components/schemas/SafetyDTO"
          },
          "natural_cost": {
            "type": "number",
            "title": "Natural Cost"
          },
          "mitigations": {
            "items": {
              "$ref": "#/components/schemas/MitigationDTO"
            },
            "type": "array",
            "title": "Mitigations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "placements",
          "cost",
          "score_breakdown",
          "violations",
          "valid",
          "accepted_steps",
          "source_sample_index",
          "safety",
          "natural_cost",
          "mitigations"
        ],
        "title": "CandidateDTO"
      },
      "EvaluationDTO": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "evaluation_version": {
            "type": "integer",
            "title": "Evaluation Version",
            "default": 2
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "breakdown": {
            "items": {
              "$ref": "#/components/schemas/ScoreTerm"
            },
            "type": "array",
            "title": "Breakdown"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Violations"
          },
          "fall_overlap_cells": {
            "type": "number",
            "title": "Fall Overlap Cells"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/RegionDTO"
            },
            "type": "array",
            "title": "Regions"
          },
          "safety": {
            "$ref": "#/components/schemas/SafetyDTO"
          },
          "natural_cost": {
            "type": "number",
            "title": "Natural Cost"
          },
          "mitigations": {
            "items": {
              "$ref": "#/components/schemas/MitigationDTO"
            },
            "type": "array",
            "title": "Mitigations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "total",
          "breakdown",
          "violations",
          "fall_overlap_cells",
          "regions",
          "safety",
          "natural_cost",
          "mitigations"
        ],
        "title": "EvaluationDTO"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobDTO": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateDTO"
            },
            "type": "array",
            "title": "Candidates"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "revision",
          "status"
        ],
        "title": "JobDTO"
      },
      "LayoutDTO": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "revision": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Revision",
            "default": 0
          },
          "room": {
            "$ref": "#/components/schemas/RoomDTO"
          },
          "placements": {
            "items": {
              "$ref": "#/components/schemas/PlacementDTO"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Placements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "room",
          "placements"
        ],
        "title": "LayoutDTO"
      },
      "MitigationDTO": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "kind": {
            "type": "string",
            "enum": [
              "furniture",
              "window"
            ],
            "title": "Kind"
          },
          "restraint": {
            "type": "string",
            "enum": [
              "unknown",
              "none",
              "wall_bracket",
              "belt",
              "pole",
              "pole_combination",
              "other"
            ],
            "title": "Restraint",
            "default": "unknown"
          },
          "installation_confirmed": {
            "type": "boolean",
            "title": "Installation Confirmed",
            "default": false
          },
          "film": {
            "type": "string",
            "enum": [
              "unknown",
              "none",
              "present"
            ],
            "title": "Film",
            "default": "unknown"
          },
          "curtains": {
            "type": "string",
            "enum": [
              "unknown",
              "none",
              "present"
            ],
            "title": "Curtains",
            "default": "unknown"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "kind"
        ],
        "title": "MitigationDTO"
      },
      "OpeningDTO": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Key"
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "title": "Label",
            "default": "Opening"
          },
          "wall": {
            "type": "string",
            "enum": [
              "LEFT",
              "RIGHT",
              "TOP",
              "BOTTOM"
            ],
            "title": "Wall"
          },
          "offset": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 0.0,
            "title": "Offset"
          },
          "length": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Length"
          },
          "placed": {
            "type": "boolean",
            "title": "Placed",
            "default": true
          },
          "film": {
            "type": "string",
            "enum": [
              "unknown",
              "none",
              "present"
            ],
            "title": "Film",
            "default": "unknown"
          },
          "curtains": {
            "type": "string",
            "enum": [
              "unknown",
              "none",
              "present"
            ],
            "title": "Curtains",
            "default": "unknown"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "wall",
          "offset",
          "length"
        ],
        "title": "OpeningDTO"
      },
      "OptimizationDTO": {
        "properties": {
          "layout": {
            "$ref": "#/components/schemas/LayoutDTO"
          },
          "fixed_keys": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Fixed Keys"
          },
          "candidate_count": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Candidate Count",
            "default": 3
          },
          "sample_count": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 2.0,
            "title": "Sample Count",
            "default": 900
          },
          "burn_in": {
            "type": "integer",
            "maximum": 4999.0,
            "minimum": 0.0,
            "title": "Burn In",
            "default": 250
          },
          "sample_stride": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Sample Stride",
            "default": 15
          },
          "rng_seed": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rng Seed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "layout"
        ],
        "title": "OptimizationDTO"
      },
      "PlacementDTO": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Key"
          },
          "gx": {
            "type": "number",
            "maximum": 64.0,
            "minimum": -64.0,
            "title": "Gx",
            "default": 0
          },
          "gy": {
            "type": "number",
            "maximum": 64.0,
            "minimum": -64.0,
            "title": "Gy",
            "default": 0
          },
          "rotation": {
            "type": "number",
            "exclusiveMaximum": 4.0,
            "minimum": 0.0,
            "title": "Rotation",
            "description": "Clockwise quarter turns, fractional values allowed (0.5 = 45 degrees)",
            "default": 0
          },
          "placed": {
            "type": "boolean",
            "title": "Placed",
            "default": false
          },
          "restraint": {
            "type": "string",
            "enum": [
              "unknown",
              "none",
              "wall_bracket",
              "belt",
              "pole",
              "pole_combination",
              "other"
            ],
            "title": "Restraint",
            "default": "unknown"
          },
          "installation_confirmed": {
            "type": "boolean",
            "title": "Installation Confirmed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key"
        ],
        "title": "PlacementDTO"
      },
      "PointDTO": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "PointDTO"
      },
      "RegionDTO": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "x0": {
            "type": "number",
            "title": "X0"
          },
          "y0": {
            "type": "number",
            "title": "Y0"
          },
          "x1": {
            "type": "number",
            "title": "X1"
          },
          "y1": {
            "type": "number",
            "title": "Y1"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/PointDTO"
            },
            "type": "array",
            "title": "Points"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id",
            "default": ""
          },
          "direction": {
            "type": "string",
            "title": "Direction",
            "default": ""
          },
          "primary": {
            "type": "boolean",
            "title": "Primary",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "key",
          "x0",
          "y0",
          "x1",
          "y1",
          "points"
        ],
        "title": "RegionDTO"
      },
      "RoomDTO": {
        "properties": {
          "grid_w": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 4.0,
            "title": "Grid W"
          },
          "grid_h": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 4.0,
            "title": "Grid H"
          },
          "ceiling_height_m": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 2.0,
            "title": "Ceiling Height M",
            "default": 2.5
          },
          "doors": {
            "items": {
              "$ref": "#/components/schemas/OpeningDTO"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Doors"
          },
          "windows": {
            "items": {
              "$ref": "#/components/schemas/OpeningDTO"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Windows"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "grid_w",
          "grid_h"
        ],
        "title": "RoomDTO"
      },
      "SafetyDTO": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "met",
              "unmet",
              "not_evaluated"
            ],
            "title": "Status"
          },
          "violation_count": {
            "type": "integer",
            "title": "Violation Count"
          },
          "overlap_area_m2": {
            "type": "number",
            "title": "Overlap Area M2"
          },
          "primary_overlap_area_m2": {
            "type": "number",
            "title": "Primary Overlap Area M2"
          },
          "route_checks": {
            "type": "integer",
            "title": "Route Checks"
          },
          "failed_route_checks": {
            "type": "integer",
            "title": "Failed Route Checks"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/SafetyIssue"
            },
            "type": "array",
            "title": "Issues"
          },
          "window_distances": {
            "items": {
              "$ref": "#/components/schemas/WindowDistance"
            },
            "type": "array",
            "title": "Window Distances"
          },
          "unassessed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unassessed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "violation_count",
          "overlap_area_m2",
          "primary_overlap_area_m2",
          "route_checks",
          "failed_route_checks",
          "issues",
          "window_distances",
          "unassessed"
        ],
        "title": "SafetyDTO"
      },
      "SafetyIssue": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "source_key": {
            "type": "string",
            "title": "Source Key"
          },
          "target_key": {
            "type": "string",
            "title": "Target Key"
          },
          "area_m2": {
            "type": "number",
            "title": "Area M2",
            "default": 0.0
          },
          "primary": {
            "type": "boolean",
            "title": "Primary",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "kind",
          "scenario_id",
          "source_key",
          "target_key"
        ],
        "title": "SafetyIssue"
      },
      "ScoreTerm": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "value": {
            "type": "number",
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "title": "ScoreTerm"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WindowDistance": {
        "properties": {
          "window_key": {
            "type": "string",
            "title": "Window Key"
          },
          "target_key": {
            "type": "string",
            "title": "Target Key"
          },
          "distance_m": {
            "type": "number",
            "title": "Distance M"
          },
          "penalty": {
            "type": "number",
            "title": "Penalty"
          }
        },
        "type": "object",
        "required": [
          "window_key",
          "target_key",
          "distance_m",
          "penalty"
        ],
        "title": "WindowDistance"
      }
    }
  }
}
